stroke
newpath 142 136 moveto
135 128 lineto
145 132 lineto
closepath
gsave 0 setgray stroke grestore fill
gsave 10 dict begin
202 155 moveto (No) 17 14.00 -0.50 alignedtext
end grestore

%	end
gsave 10 dict begin
filled
261 110 27 18 ellipse_path
gsave 0 setgray stroke grestore fill
gsave 10 dict begin
0.000 0.000 1.000 nodecolor
261 111 moveto (End) 22 14.00 -0.50 alignedtext
end grestore
end grestore

%	sat -> end
newpath 244 180 moveto
247 168 251 151 255 137 curveto
stroke
newpath 252 137 moveto
257 128 lineto
257 138 lineto
closepath
gsave 0 setgray stroke grestore fill
gsave 10 dict begin
270 155 moveto (Yes) 21 14.00 -0.50 alignedtext
end grestore

%	init
gsave 10 dict begin
filled
299 351 81 22 ellipse_path
gsave 0 setgray stroke grestore fill
gsave 10 dict begin
0.000 0.000 1.000 nodecolor
299 360 moveto (Create initial population) 136 14.00 -0.50 alignedtext
299 344 moveto (gens = 0) 47 14.00 -0.50 alignedtext
end grestore
end grestore

%	init -> eval
newpath 299 328 moveto
299 319 299 309 299 299 curveto
stroke
newpath 297 300 moveto
299 290 lineto
302 300 lineto
closepath
gsave 0 setgray stroke grestore fill
endpage
grestore
