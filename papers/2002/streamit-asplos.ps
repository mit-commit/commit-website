/@RestoreState {
	/:savelevel :savelevel 1 sub def
	:savestack :savelevel get aload pop
	/:state exch def
	/_i  exch def
	/cs  exch def
	/rb  exch def
	/ra  exch def
} def

/@Interpret {
	{
	  @Read
	  procs :state get exec
	  /:state exch def
	} loop
	pop
}bind def

