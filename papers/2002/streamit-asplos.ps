/Helvetica-Bold exch definefont pop
% stack: save fontname true true  => printer resident font and needs Euro
%    or: save false true          => printer resident font and does not need Euro
%    or: false                    => no printer resident font
ct_EuroDict begin
{
   % Printer Resident font exists. If a Euro is needed and it is in
   % faux font get it from the faux font and add it to the
   % printer resident font.
   % If not use 'restore' to remove the faux font from VM.
   % stack: save fontname true | save false
        {
	    dup findfont /InfoDict get /Euro known
	        {/Euro ct_AddGlyphToPrinterFont }
                { pop restore }
            ifelse
        }
        { restore }
    ifelse
}
if
end	% ct_EuroDict
%%EndFont

